   }
 
+  /// Return one exact chat row with the same projection as `listChats`.
+  ///
+  /// Chats without a joined message are intentionally absent because they are
+  /// not enumerable by `listChats` and have no meaningful ordering timestamp.
+  public func chat(chatID: Int64) throws -> Chat? {
+    guard chatID > 0 else { return nil }
+    return try withConnection { db in
+      let query = ChatByIDQuery(chatID: ChatID(rawValue: chatID), schema: schema)
+      let rows = try chatRows(sql: query.sql, bindings: query.bindings, db: db)
+      guard let row = rows.first else { return nil }
+      let counts = try unreadCounts(for: [row.id], db: db)
+      return chat(from: row, unreadCount: counts[row.id])
+    }
+  }
+
   private func chatRows(for query: ListChatsQuery, db: Connection) throws -> [ChatRow] {
+    try chatRows(sql: query.sql, bindings: query.bindings, db: db)
+  }
+
