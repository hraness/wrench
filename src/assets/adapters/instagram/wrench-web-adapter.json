      "sideEffect": "none",
      "idempotency": "none",
      "dedupeWindowMs": 0,
      "input": {
        "properties": {
          "thread_limit": {
            "type": "number",
            "description": "Maximum first-page inbox threads inspected for participants",
            "minimum": 1,
            "maximum": 50
          },
          "contact_limit": {
            "type": "number",
            "description": "Maximum unique participant contacts projected",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": []
      },
      "webSession": {
        "site": "instagram",
        "action": "contacts.list",
        "contractVersion": 1,
        "timeoutMs": 60000,
        "maxOutputBytes": 8388608
      }
    },
