            "enum": [
              "friends",
              "messenger-participants"
            ]
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor returned by the preceding reviewed page",
            "minLength": 1,
            "maxLength": 4096
          },
          "limit": {
            "type": "number",
            "description": "Maximum projected contacts",
            "minimum": 1,
            "maximum": 100
          },
          "stats_scan_limit": {
            "type": "number",
            "description": "Maximum reviewed message-history entries scanned per contact and direction",
            "minimum": 1,
            "maximum": 2000
          }
        },
        "required": [
          "source"
