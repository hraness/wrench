  "operations": {
    "profiles.read": {
      "description": "Observed contract: read one exact Bluesky profile through the fixed public AppView getProfile query with DID and handle binding plus exact follower, following, and post counts.",
      "risk": "R1",
      "sideEffect": "none",
      "idempotency": "none",
      "dedupeWindowMs": 0,
      "input": {
        "properties": {
          "handle": {
            "type": "string",
            "description": "Exact fully qualified Bluesky handle",
            "minLength": 3,
            "maxLength": 253
          }
        },
        "required": [
          "handle"
        ]
      },
      "webSession": {
        "site": "bluesky",
        "action": "profiles.read",
        "contractVersion": 2,
        "timeoutMs": 60000,
        "maxOutputBytes": 2097152
      }
    },
    "feeds.read": {
      "description": "Read one bounded authenticated Bluesky home timeline, notification feed, or private bookmark feed through fixed account-bound XRPC queries.",
      "risk": "R1",
      "sideEffect": "none",
      "idempotency": "none",
      "dedupeWindowMs": 0,
      "input": {
        "properties": {
          "feed": {
            "type": "string",
            "description": "Exact reviewed Bluesky feed",
            "enum": [
              "home",
              "notifications",
              "bookmarks"
            ]
          },
          "limit": {
            "type": "number",
            "description": "Maximum projected feed items",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "description": "Optional opaque cursor returned by the same feed",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "feed"
        ]
      },
      "webSession": {
        "site": "bluesky",
        "action": "feeds.read",
        "contractVersion": 1,
        "timeoutMs": 60000,
        "maxOutputBytes": 8388608
      }
    },
