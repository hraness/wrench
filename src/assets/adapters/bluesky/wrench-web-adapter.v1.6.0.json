      "description": "Publish one confirmed Bluesky video post through a fixed first-party legacy video-service upload, bounded response-bound processing poll, repository record, durable accepted target, and authoritative record plus AppView readback.",
      "risk": "R3",
      "sideEffect": "Uploads one video and publishes one externally visible Bluesky post with the exact confirmed text and accessibility description.",
      "idempotency": "local-at-most-once",
      "dedupeWindowMs": 86400000,
      "input": {
