    "feeds.read": {
      "description": "Observed contract: read one bounded signer-free TikTok For You response through the exact first-party recommendation endpoint after binding the current viewer.",
      "risk": "R1",
      "sideEffect": "none",
      "idempotency": "none",
      "dedupeWindowMs": 0,
      "input": {
        "properties": {
          "feed": {
            "type": "string",
            "description": "Exact TikTok feed supported by the reviewed direct request",
            "enum": [
              "for-you"
            ]
          },
          "limit": {
            "type": "number",
            "description": "Maximum complete response page to project",
            "minimum": 1,
            "maximum": 30
          }
        },
        "required": [
          "feed"
        ]
      },
      "webSession": {
        "site": "tiktok",
        "action": "feeds.read",
        "contractVersion": 1,
        "timeoutMs": 60000,
        "maxOutputBytes": 4194304
      }
    },
