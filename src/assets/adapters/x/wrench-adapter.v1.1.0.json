  "operations": {
    "feeds.read": {
      "description": "Use the code-owned official x API contract for feeds.read. fixed X v2 reverse-chron/user/mentions/List/recent-search/bookmark endpoints with endpoint-specific no-skip page minima; never For You",
      "risk": "R1",
      "sideEffect": "none",
      "idempotency": "none",
      "dedupeWindowMs": 0,
      "input": {
        "properties": {
          "feed": {
            "type": "string",
            "description": "Exact official timeline or discovery surface",
            "enum": [
              "home-reverse-chronological",
              "user",
              "mentions",
              "list",
              "recent-search",
              "bookmarks"
            ]
          },
          "user_id": {
            "type": "string",
            "description": "Exact 1-19 digit X user ID for user or mentions feeds",
            "minLength": 1,
            "maxLength": 19
          },
          "list_id": {
            "type": "string",
            "description": "Exact 1-19 digit X List ID",
            "minLength": 1,
            "maxLength": 19
          },
          "query": {
            "type": "string",
            "description": "Recent-search query covering at most seven days",
            "minLength": 1,
            "maxLength": 512
          },
          "cursor": {
            "type": "string",
            "description": "Opaque provider pagination token",
            "minLength": 1,
            "maxLength": 4096
          },
          "limit": {
            "type": "number",
            "description": "Bounded result count",
            "minimum": 1,
            "maximum": 100
          },
          "since_id": {
            "type": "string",
            "description": "Return posts newer than this 1-19 digit post ID",
            "minLength": 1,
            "maxLength": 19
          },
          "until_id": {
            "type": "string",
            "description": "Return posts older than this 1-19 digit post ID",
            "minLength": 1,
            "maxLength": 19
          },
          "start_time": {
            "type": "string",
            "description": "Inclusive ISO-8601 start time",
            "minLength": 20,
            "maxLength": 40
          },
          "end_time": {
            "type": "string",
            "description": "Exclusive ISO-8601 end time",
            "minLength": 20,
            "maxLength": 40
          },
          "exclude_replies": {
            "type": "boolean",
            "description": "Exclude replies where the endpoint supports it"
          },
          "exclude_reposts": {
            "type": "boolean",
            "description": "Exclude reposts where the endpoint supports it"
          },
          "sort": {
            "type": "string",
            "description": "Recent-search ordering",
            "enum": [
              "recency",
              "relevancy"
            ]
          }
        },
        "required": [
          "feed"
        ]
      },
      "provider": {
        "provider": "x",
        "action": "feeds.read",
        "contractVersion": 1,
        "timeoutMs": 60000,
        "maxOutputBytes": 2097152
      }
    },
