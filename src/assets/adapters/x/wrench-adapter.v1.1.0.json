            "minLength": 1,
            "maxLength": 280
          },
          "media": {
            "type": "array",
            "description": "Up to four images, or one GIF/video",
            "items": {
              "type": "file",
              "description": "One reviewed X post attachment",
              "maxBytes": 536870912,
              "mediaTypes": [
                "image/jpeg",
