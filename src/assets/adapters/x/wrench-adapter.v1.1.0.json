    "messaging.send": {
      "description": "Use the code-owned official x API contract for messaging.send. optional official media upload then POST legacy DM message; explicit opt-in; not encrypted Chat",
      "risk": "R3",
      "sideEffect": "Mutates x through the exact confirmed messaging.send official API contract.",
      "idempotency": "local-at-most-once",
      "dedupeWindowMs": 86400000,
      "input": {
        "properties": {
          "target_kind": {
            "type": "string",
            "description": "Send to one participant or existing legacy DM conversation",
            "enum": [
              "participant",
              "conversation"
            ]
          },
          "target_id": {
            "type": "string",
            "description": "Exact participant or legacy DM conversation ID",
            "minLength": 1,
            "maxLength": 39
          },
          "body": {
            "type": "string",
            "description": "Optional exact legacy DM text; text or media is required",
            "minLength": 1,
            "maxLength": 1000
          },
          "media": {
            "type": "file",
            "description": "Optional single legacy DM image, GIF, or video",
            "maxBytes": 536870912,
            "mediaTypes": [
              "image/jpeg",
              "image/png",
              "image/gif",
              "video/mp4"
            ]
          },
          "media_alt_text": {
            "type": "string",
            "description": "Optional accessibility text applied to reviewed JPEG/PNG DM media",
            "minLength": 1,
            "maxLength": 1000
          },
          "recipient_opted_in": {
            "type": "boolean",
            "description": "Required acknowledgement that the recipient opted into automated contact",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "target_kind",
          "target_id",
          "recipient_opted_in"
        ]
      },
      "provider": {
        "provider": "x",
        "action": "messaging.send",
        "contractVersion": 1,
        "timeoutMs": 600000,
        "maxOutputBytes": 2097152
      }
    },
    "posts.publish": {
      "description": "Use the code-owned official x API contract for posts.publish. optional official X v2 media upload then POST /2/tweets; media/poll union enforced",
      "risk": "R3",
      "sideEffect": "Mutates x through the exact confirmed posts.publish official API contract.",
