{
  "schemaVersion": 4,
  "id": "github-web",
  "version": "1.2.0",
  "displayName": "GitHub (Public Statistics REST API)",
  "surfaceId": "github",
  "origins": [
    "https://github.com"
  ],
  "browserDomains": [
    "github.com"
  ],
  "operations": {
    "profiles.read": {
      "description": "Read one exact public GitHub user through the fixed REST user endpoint with login, immutable numeric account ID, canonical profile URL, and exact follower, following, and public repository counts.",
      "risk": "R1",
      "sideEffect": "none",
      "idempotency": "none",
      "dedupeWindowMs": 0,
      "input": {
        "properties": {
          "username": {
            "type": "string",
            "description": "Exact GitHub username",
            "minLength": 1,
            "maxLength": 39
          }
        },
        "required": [
          "username"
        ]
      },
      "webSession": {
        "site": "github",
        "action": "profiles.read",
        "contractVersion": 1,
        "timeoutMs": 60000,
        "maxOutputBytes": 2097152
      }
    },
    "organizations.read": {
      "description": "Read one exact public GitHub organization, bind its immutable numeric organization ID, canonical public URL, exact follower count, and declared public repository count, then complete the fixed public repository pagination before summing exact stargazer counts across every listed public repository.",
      "risk": "R1",
      "sideEffect": "none",
      "idempotency": "none",
      "dedupeWindowMs": 0,
      "input": {
        "properties": {
          "organization": {
            "type": "string",
            "description": "Exact GitHub organization login",
            "minLength": 1,
            "maxLength": 39
          }
        },
        "required": [
          "organization"
        ]
      },
      "webSession": {
        "site": "github",
        "action": "organizations.read",
        "contractVersion": 1,
        "timeoutMs": 60000,
        "maxOutputBytes": 2097152
      }
    }
  }
}
