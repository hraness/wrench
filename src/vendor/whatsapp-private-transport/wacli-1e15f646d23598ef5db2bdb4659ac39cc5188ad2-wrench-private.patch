+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/fsutil"
+)
+
+func TestWrenchPrivateProtocolAuthenticatesExactBindingAndPayload(t *testing.T) {
+	key := bytes.Repeat([]byte{0x42}, 32)
+	req := privateSendRequest(time.Second)
+	req.Binding = wrenchDaemonBinding{
+		ProtocolHash:    wrenchPrivateProtocolHash(),
+		ToolHash:        strings.Repeat("a", 64),
+		StoreSubject:    strings.Repeat("b", 64),
+		AuthSubject:     strings.Repeat("c", 64),
+		DaemonPID:       123,
+		DaemonStartedAt: "2026-08-27T12:00:00Z",
+		ConnectionEpoch: 7,
+	}
+	req.MAC = wrenchPrivateSignRequest(key, req)
+	if !wrenchPrivateVerifyMAC(req.MAC, wrenchPrivateSignRequest(key, req)) {
+		t.Fatal("valid MAC rejected")
+	}
+	tampered := req
+	tampered.Send = &wrenchPrivateSendPayload{}
+	*tampered.Send = *req.Send
+	tampered.Send.Message = "tampered"
+	if wrenchPrivateVerifyMAC(tampered.MAC, wrenchPrivateSignRequest(key, tampered)) {
+		t.Fatal("tampered body authenticated")
+	}
+	tampered = req
+	tampered.Binding.ConnectionEpoch++
+	if wrenchPrivateVerifyMAC(tampered.MAC, wrenchPrivateSignRequest(key, tampered)) {
+		t.Fatal("tampered epoch authenticated")
+	}
+}
+
+func TestWrenchPrivateReplayCacheFailsClosedAtCapacity(t *testing.T) {
+	cache := newWrenchPrivateReplayCache(1)
+	now := time.Now()
+	if !cache.accept("one", now) {
+		t.Fatal("first nonce rejected")
+	}
+	if cache.accept("one", now) {
+		t.Fatal("replayed nonce accepted")
+	}
+	if cache.accept("two", now) {
+		t.Fatal("nonce accepted past capacity")
+	}
+}
+
+func TestWrenchPrivateInputRequiresOwnerOnlyRegularFile(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "payload.json")
+	if err := fsutil.WritePrivateFile(path, []byte(`{"message":"secret"}`)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := wrenchPrivateReadFile(path, wrenchPrivateMaxPayload); err != nil {
+		t.Fatalf("0600 file: %v", err)
+	}
+	if err := os.Chmod(path, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := wrenchPrivateReadFile(path, wrenchPrivateMaxPayload); err == nil {
+		t.Fatal("0644 file accepted")
+	}
+	link := filepath.Join(dir, "payload-link.json")
+	if err := os.Symlink(path, link); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := wrenchPrivateReadFile(link, wrenchPrivateMaxPayload); err == nil {
+		t.Fatal("symlink accepted")
+	}
+}
+
+func TestWrenchPrivateCommandHasNoMessageArgumentOrEnvironmentSurface(t *testing.T) {
+	cmd := newWrenchPrivateSendCmd(&rootFlags{})
+	for _, name := range []string{"message", "to", "reply-to", "body"} {
+		if cmd.Flags().Lookup(name) != nil {
+			t.Fatalf("private field exposed as --%s", name)
+		}
+	}
+	cmd.SetArgs([]string{"private body must not be argv"})
+	if err := cmd.Execute(); err == nil {
+		t.Fatal("positional body argument accepted")
+	}
+}
