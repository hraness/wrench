+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+go_bin="${GO_BIN:-go}"
+expected_go="go1.25.12"
+expected_module="v0.0.0-20260716095330-85d99080dee8"
+patch_path="$repo_root/patches/whatsmeow-85d99080dee8-wrench-private.patch"
+
+if [[ "$($go_bin env GOVERSION)" != "$expected_go" ]]; then
+  echo "expected $expected_go, got $($go_bin env GOVERSION)" >&2
+  exit 1
+fi
+
+actual_module="$(cd "$repo_root" && GOTOOLCHAIN=local "$go_bin" list -m -f '{{.Version}}' go.mau.fi/whatsmeow)"
+if [[ "$actual_module" != "$expected_module" ]]; then
+  echo "expected whatsmeow $expected_module, got $actual_module" >&2
+  exit 1
+fi
+
+GOTOOLCHAIN=local "$go_bin" mod download "go.mau.fi/whatsmeow@$expected_module"
+module_dir="$($go_bin env GOMODCACHE)/go.mau.fi/whatsmeow@$expected_module"
+if [[ ! -d "$module_dir" ]]; then
+  echo "pinned whatsmeow module directory is missing" >&2
+  exit 1
+fi
+
+prototype_tmp="$(mktemp -d "${TMPDIR:-/tmp}/wacli-wrench-private.XXXXXX")"
+trap 'rm -rf "$prototype_tmp"' EXIT
+cp -R "$module_dir" "$prototype_tmp/whatsmeow"
+chmod -R u+w "$prototype_tmp/whatsmeow"
+
+(
+  cd "$prototype_tmp/whatsmeow"
+  git apply --check "$patch_path"
+  git apply "$patch_path"
+)
+
+cp "$repo_root/go.mod" "$prototype_tmp/wacli.mod"
+cp "$repo_root/go.sum" "$prototype_tmp/wacli.sum"
+GOTOOLCHAIN=local "$go_bin" mod edit -modfile="$prototype_tmp/wacli.mod" \
+  -replace="go.mau.fi/whatsmeow=$prototype_tmp/whatsmeow"
+
+(
+  cd "$prototype_tmp/whatsmeow"
+  GOTOOLCHAIN=local "$go_bin" test . -run 'TestWrenchReceiveBarrier' -count=1
+)
+(
+  cd "$repo_root"
+  GOTOOLCHAIN=local "$go_bin" test -modfile="$prototype_tmp/wacli.mod" \
+    -tags wrench_private_transport ./cmd/wacli ./internal/app ./internal/wa -count=1
+  GOTOOLCHAIN=local CGO_ENABLED=1 CGO_CFLAGS="${CGO_CFLAGS:+$CGO_CFLAGS }-Wno-error=missing-braces" \
+    "$go_bin" build -modfile="$prototype_tmp/wacli.mod" -tags 'sqlite_fts5 wrench_private_transport' \
+    -o "$prototype_tmp/wacli" ./cmd/wacli
+)
+
+echo "wrench private transport prototype verified"
