+@@ -0,0 +1,330 @@
++package whatsmeow
++
++import (
++	"context"
++	"errors"
++	"fmt"
++	"sync"
++	"time"
++
++	waBinary "go.mau.fi/whatsmeow/binary"
++	"go.mau.fi/whatsmeow/types"
++)
++
++var (
++	ErrWrenchBarrierNotConnected   = errors.New("wrench receive barrier is not connected")
++	ErrWrenchBarrierEpochDrift     = errors.New("wrench receive barrier connection epoch changed")
++	ErrWrenchBarrierQueueOverflow  = errors.New("wrench receive barrier observed handler queue overflow")
++	ErrWrenchBarrierHandlerEscaped = errors.New("wrench receive barrier observed an escaped or late handler")
++	ErrWrenchBarrierHandlerFailed  = errors.New("wrench receive barrier observed a failed event handler")
++)
++
++// WrenchReceiveBarrierProof proves that an exact keepalive IQ response was
++// received on one connection and that every earlier queued node handler
++// returned. Event handlers invoked synchronously by those node handlers have
++// therefore returned too.
++type WrenchReceiveBarrierProof struct {
++	ConnectionEpoch  uint64
++	ResponseSequence uint64
++}
++
++type wrenchSequencedNode struct {
++	node     *waBinary.Node
++	epoch    uint64
++	sequence uint64
++}
++
++type wrenchResponseSequence struct {
++	epoch    uint64
++	sequence uint64
++}
++
++type wrenchReceiveBarrierState struct {
++	mu sync.Mutex
++
++	changed chan struct{}
++
++	epoch     uint64
++	connected bool
++	sequence  uint64
++	pending   map[uint64]struct{}
++
++	queueOverflowSequence uint64
++	escapedSequence       uint64
++	failedSequence        uint64
++
++	barrierResponses map[string]chan wrenchResponseSequence
++
++	activeEpoch    uint64
++	activeSequence uint64
++}
++
++func newWrenchReceiveBarrierState() *wrenchReceiveBarrierState {
++	return &wrenchReceiveBarrierState{
++		changed:          make(chan struct{}),
++		pending:          make(map[uint64]struct{}),
++		barrierResponses: make(map[string]chan wrenchResponseSequence),
++	}
++}
++
++func (s *wrenchReceiveBarrierState) signalLocked() {
++	close(s.changed)
++	s.changed = make(chan struct{})
++}
++
++func (s *wrenchReceiveBarrierState) beginConnection() uint64 {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	s.epoch++
++	s.connected = true
++	s.sequence = 0
++	s.pending = make(map[uint64]struct{})
++	s.queueOverflowSequence = 0
++	s.escapedSequence = 0
++	s.failedSequence = 0
++	s.activeEpoch = 0
++	s.activeSequence = 0
++	for id, waiter := range s.barrierResponses {
++		close(waiter)
++		delete(s.barrierResponses, id)
++	}
++	s.signalLocked()
++	return s.epoch
++}
++
++func (s *wrenchReceiveBarrierState) endConnection() {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	if !s.connected {
++		return
++	}
++	s.connected = false
++	for id, waiter := range s.barrierResponses {
++		close(waiter)
++		delete(s.barrierResponses, id)
++	}
++	s.signalLocked()
++}
++
++func (s *wrenchReceiveBarrierState) connectionEpoch() (uint64, bool) {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	return s.epoch, s.connected
++}
++
++func (s *wrenchReceiveBarrierState) observeFrame() (uint64, uint64) {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	s.sequence++
++	return s.epoch, s.sequence
++}
++
++func (s *wrenchReceiveBarrierState) registerHandler(epoch, sequence uint64) {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	if s.connected && s.epoch == epoch {
++		s.pending[sequence] = struct{}{}
++		s.signalLocked()
++	}
++}
++
++func (s *wrenchReceiveBarrierState) startHandler(epoch, sequence uint64) bool {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	if !s.connected || s.epoch != epoch {
++		if s.escapedSequence == 0 || sequence < s.escapedSequence {
++			s.escapedSequence = sequence
++		}
++		s.signalLocked()
++		return false
++	}
++	s.activeEpoch = epoch
++	s.activeSequence = sequence
++	return true
++}
++
++func (s *wrenchReceiveBarrierState) finishHandler(epoch, sequence uint64) {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	if s.epoch != epoch {
++		if s.escapedSequence == 0 || sequence < s.escapedSequence {
++			s.escapedSequence = sequence
++		}
++	} else {
++		delete(s.pending, sequence)
++	}
++	if s.activeEpoch == epoch && s.activeSequence == sequence {
++		s.activeEpoch = 0
++		s.activeSequence = 0
++	}
++	s.signalLocked()
++}
++
++func (s *wrenchReceiveBarrierState) markQueueOverflow(epoch, sequence uint64) {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	if s.epoch == epoch && (s.queueOverflowSequence == 0 || sequence < s.queueOverflowSequence) {
++		s.queueOverflowSequence = sequence
++	}
++	s.signalLocked()
++}
++
++func (s *wrenchReceiveBarrierState) markHandlerEscaped(epoch, sequence uint64) {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	if s.epoch == epoch && (s.escapedSequence == 0 || sequence < s.escapedSequence) {
++		s.escapedSequence = sequence
++	}
++	s.signalLocked()
++}
++
++func (s *wrenchReceiveBarrierState) markActiveHandlerFailed() {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	sequence := s.activeSequence
++	if sequence == 0 {
++		sequence = s.sequence
++	}
++	if s.failedSequence == 0 || sequence < s.failedSequence {
++		s.failedSequence = sequence
++	}
++	s.signalLocked()
++}
++
++func (s *wrenchReceiveBarrierState) registerBarrierResponse(id string) <-chan wrenchResponseSequence {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	ch := make(chan wrenchResponseSequence, 1)
++	s.barrierResponses[id] = ch
++	return ch
++}
++
++func (s *wrenchReceiveBarrierState) cancelBarrierResponse(id string) {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	if waiter, ok := s.barrierResponses[id]; ok {
++		delete(s.barrierResponses, id)
++		close(waiter)
++	}
++}
++
++func (s *wrenchReceiveBarrierState) noteResponse(id string, epoch, sequence uint64) {
++	s.mu.Lock()
++	defer s.mu.Unlock()
++	waiter, ok := s.barrierResponses[id]
++	if !ok {
++		return
++	}
++	delete(s.barrierResponses, id)
++	waiter <- wrenchResponseSequence{epoch: epoch, sequence: sequence}
++	close(waiter)
++}
++
++func (s *wrenchReceiveBarrierState) wait(ctx context.Context, epoch, through uint64) error {
++	for {
++		s.mu.Lock()
++		if !s.connected {
++			s.mu.Unlock()
++			return ErrWrenchBarrierNotConnected
++		}
++		if s.epoch != epoch {
++			s.mu.Unlock()
++			return ErrWrenchBarrierEpochDrift
++		}
++		if s.queueOverflowSequence != 0 && s.queueOverflowSequence <= through {
++			s.mu.Unlock()
++			return ErrWrenchBarrierQueueOverflow
++		}
++		if s.escapedSequence != 0 && s.escapedSequence <= through {
++			s.mu.Unlock()
++			return ErrWrenchBarrierHandlerEscaped
++		}
++		if s.failedSequence != 0 && s.failedSequence <= through {
++			s.mu.Unlock()
++			return ErrWrenchBarrierHandlerFailed
++		}
++		pending := false
++		for sequence := range s.pending {
++			if sequence <= through {
++				pending = true
++				break
++			}
++		}
++		if !pending {
++			s.mu.Unlock()
++			return nil
++		}
++		changed := s.changed
++		s.mu.Unlock()
++		select {
++		case <-changed:
++		case <-ctx.Done():
++			return ctx.Err()
++		}
++	}
++}
++
++func wrenchKeepaliveQuery(id string, timeout time.Duration) infoQuery {
++	return infoQuery{
++		Namespace: "w:p",
++		Type:      iqGet,
++		To:        types.ServerJID,
++		ID:        id,
++		Timeout:   timeout,
++		NoRetry:   true,
++	}
++}
++
++// WrenchConnectionEpoch returns the connection generation used by the Wrench
++// receive barrier. The boolean is false unless a live post-handshake socket is
++// owned by this Client.
++func (cli *Client) WrenchConnectionEpoch() (uint64, bool) {
++	if cli == nil || cli.wrenchReceiveBarrier == nil {
++		return 0, false
++	}
++	return cli.wrenchReceiveBarrier.connectionEpoch()
++}
++
++// WrenchReceiveBarrier sends the same bounded keepalive IQ as whatsmeow's own
++// liveness loop and then drains all earlier non-response handlers. The caller
++// must supply a deadline so blackholed and half-open connections fail closed.
++func (cli *Client) WrenchReceiveBarrier(ctx context.Context) (WrenchReceiveBarrierProof, error) {
++	if cli == nil || cli.wrenchReceiveBarrier == nil {
++		return WrenchReceiveBarrierProof{}, ErrClientIsNil
++	}
++	deadline, ok := ctx.Deadline()
++	if !ok {
++		return WrenchReceiveBarrierProof{}, fmt.Errorf("wrench receive barrier requires a context deadline")
++	}
++	epoch, connected := cli.wrenchReceiveBarrier.connectionEpoch()
++	if !connected {
++		return WrenchReceiveBarrierProof{}, ErrWrenchBarrierNotConnected
++	}
++
++	id := cli.generateRequestID()
++	responseSequence := cli.wrenchReceiveBarrier.registerBarrierResponse(id)
++	defer cli.wrenchReceiveBarrier.cancelBarrierResponse(id)
++	remaining := time.Until(deadline)
++	if remaining <= 0 {
++		return WrenchReceiveBarrierProof{}, context.DeadlineExceeded
++	}
++	_, err := cli.sendIQ(ctx, wrenchKeepaliveQuery(id, remaining))
++	if err != nil {
++		return WrenchReceiveBarrierProof{}, fmt.Errorf("wrench keepalive IQ: %w", err)
++	}
++	marker, ok := <-responseSequence
++	if !ok {
++		return WrenchReceiveBarrierProof{}, ErrWrenchBarrierEpochDrift
++	}
++	if marker.epoch != epoch {
++		return WrenchReceiveBarrierProof{}, ErrWrenchBarrierEpochDrift
++	}
++	if err := cli.wrenchReceiveBarrier.wait(ctx, epoch, marker.sequence); err != nil {
++		return WrenchReceiveBarrierProof{}, err
++	}
++	finalEpoch, connected := cli.wrenchReceiveBarrier.connectionEpoch()
++	if !connected || finalEpoch != epoch {
++		return WrenchReceiveBarrierProof{}, ErrWrenchBarrierEpochDrift
++	}
++	return WrenchReceiveBarrierProof{ConnectionEpoch: epoch, ResponseSequence: marker.sequence}, nil
++}
