@@ -0,0 +1,32 @@
+package wa
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	waProto "go.mau.fi/whatsmeow/binary/proto"
+	"go.mau.fi/whatsmeow/types"
+)
+
+var ErrWrenchPrivateTransportUnavailable = errors.New("wrench private transport requires the pinned whatsmeow patch and wrench_private_transport build tag")
+
+type WrenchBarrierProof struct {
+	ConnectionEpoch  uint64
+	ResponseSequence uint64
+}
+
+type WrenchBarrierError struct {
+	Category string
+}
+
+func (e *WrenchBarrierError) Error() string {
+	return "wrench receive barrier failed: " + e.Category
+}
+
+type WrenchPrivateTransport interface {
+	WrenchConnectionEpoch() (uint64, bool)
+	WrenchGenerateMessageID() (types.MessageID, error)
+	WrenchSendProtoNoRetry(context.Context, types.JID, *waProto.Message, types.MessageID, time.Duration) error
+	WrenchReceiveBarrier(context.Context) (WrenchBarrierProof, error)
+}
diff --git a/internal/wa/wrench_transport_patched.go b/internal/wa/wrench_transport_patched.go
new file mode 100644
index 0000000000000000000000000000000000000000..9c2410cf47b19494351a98e17d3be6c55ccf0a39
--- /dev/null
+++ b/internal/wa/wrench_transport_patched.go
@@ -0,0 +1,79 @@
+//go:build wrench_private_transport
+
+package wa
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	waProto "go.mau.fi/whatsmeow/binary/proto"
+	"go.mau.fi/whatsmeow/types"
+)
+
+func (c *Client) WrenchConnectionEpoch() (uint64, bool) {
+	c.mu.Lock()
+	cli := c.client
+	c.mu.Unlock()
+	if cli == nil {
+		return 0, false
+	}
+	return cli.WrenchConnectionEpoch()
+}
+
+func (c *Client) WrenchGenerateMessageID() (types.MessageID, error) {
+	c.mu.Lock()
+	cli := c.client
+	c.mu.Unlock()
+	if cli == nil || !cli.IsConnected() {
+		return "", fmt.Errorf("not connected")
+	}
+	return cli.GenerateMessageID(), nil
+}
+
+func (c *Client) WrenchSendProtoNoRetry(ctx context.Context, to types.JID, msg *waProto.Message, id types.MessageID, timeout time.Duration) error {
+	c.mu.Lock()
+	cli := c.client
+	c.mu.Unlock()
+	if cli == nil || !cli.IsConnected() {
+		return fmt.Errorf("not connected")
+	}
+	_, err := cli.SendMessage(ctx, to, msg, whatsmeow.SendRequestExtra{
+		ID:      id,
+		Timeout: timeout,
+		NoRetry: true,
+	})
+	return err
+}
+
+func (c *Client) WrenchReceiveBarrier(ctx context.Context) (WrenchBarrierProof, error) {
+	c.mu.Lock()
+	cli := c.client
+	c.mu.Unlock()
+	if cli == nil || !cli.IsConnected() {
+		return WrenchBarrierProof{}, fmt.Errorf("not connected")
+	}
+	proof, err := cli.WrenchReceiveBarrier(ctx)
+	if err != nil {
+		category := "barrier_failure"
+		switch {
+		case errors.Is(err, whatsmeow.ErrWrenchBarrierQueueOverflow):
+			category = "queue_overflow"
+		case errors.Is(err, whatsmeow.ErrWrenchBarrierHandlerEscaped):
+			category = "escaped_or_late_handler"
+		case errors.Is(err, whatsmeow.ErrWrenchBarrierHandlerFailed):
+			category = "transaction_or_handler_failure"
+		case errors.Is(err, whatsmeow.ErrWrenchBarrierEpochDrift), errors.Is(err, whatsmeow.ErrWrenchBarrierNotConnected):
+			category = "connection_epoch_drift"
+		case errors.Is(err, context.DeadlineExceeded), errors.Is(err, whatsmeow.ErrIQTimedOut):
+			category = "keepalive_timeout"
+		}
+		return WrenchBarrierProof{}, &WrenchBarrierError{Category: category}
+	}
+	return WrenchBarrierProof{
+		ConnectionEpoch:  proof.ConnectionEpoch,
+		ResponseSequence: proof.ResponseSequence,
+	}, nil
+}
