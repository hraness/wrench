diff --git a/cmd/wacli/wrench_private_cmd.go b/cmd/wacli/wrench_private_cmd.go
new file mode 100644
index 0000000000000000000000000000000000000000..4a539ef499b2e01898320763eaeb3329020a19a5
--- /dev/null
+++ b/cmd/wacli/wrench_private_cmd.go
@@ -0,0 +1,258 @@
+package main
+
+import (
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/openclaw/wacli/internal/app"
+	"github.com/openclaw/wacli/internal/out"
+	"github.com/spf13/cobra"
+)
+
+type wrenchPrivateServer struct {
+	storeDir string
+	key      []byte
+	binding  wrenchDaemonBinding
+	replay   *wrenchPrivateReplayCache
+	engine   *wrenchPrivateMutationEngine
+	now      func() time.Time
+}
+
+func newWrenchPrivateServer(a *app.App) (*wrenchPrivateServer, error) {
+	backend, err := newWrenchPrivateAppBackend(a)
+	if err != nil {
+		return nil, err
+	}
+	epoch, connected := backend.ConnectionEpoch()
+	if !connected {
+		return nil, fmt.Errorf("wrench private transport has no live connection epoch")
+	}
+	toolHash, err := wrenchPrivateExecutableHash()
+	if err != nil {
+		return nil, err
+	}
+	key, err := wrenchPrivateLoadOrCreateKey(a.StoreDir())
+	if err != nil {
+		return nil, err
+	}
+	startedAt := time.Now().UTC()
+	binding := wrenchDaemonBinding{
+		ProtocolHash:    wrenchPrivateProtocolHash(),
+		ToolHash:        toolHash,
+		StoreSubject:    wrenchPrivateSubject(a.StoreDir()),
+		AuthSubject:     wrenchPrivateSubject(a.WA().LinkedJID()),
+		DaemonPID:       os.Getpid(),
+		DaemonStartedAt: startedAt.Format(time.RFC3339Nano),
+		ConnectionEpoch: epoch,
+	}
+	if strings.TrimSpace(a.WA().LinkedJID()) == "" {
+		return nil, fmt.Errorf("wrench private transport requires an authenticated account subject")
+	}
+	return &wrenchPrivateServer{
+		storeDir: a.StoreDir(),
+		key:      key,
+		binding:  binding,
+		replay:   newWrenchPrivateReplayCache(wrenchPrivateReplayLimit),
+		engine:   newWrenchPrivateMutationEngine(backend, epoch),
+		now:      func() time.Time { return time.Now().UTC() },
+	}, nil
+}
+
+func startWrenchPrivateServer(ctx context.Context, a *app.App) (func(), error) {
+	server, err := newWrenchPrivateServer(a)
+	if err != nil {
+		return nil, err
+	}
+	path := wrenchPrivateSocketPath(a.StoreDir())
+	if err := removeStaleSendDelegateSocket(path); err != nil {
+		return nil, err
+	}
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		return nil, err
+	}
+	if err := os.Chmod(path, 0o600); err != nil {
+		_ = listener.Close()
+		_ = os.Remove(path)
+		return nil, err
+	}
+	status := wrenchPrivateStatusFile{
+		SchemaVersion: wrenchPrivateProtocolVersion,
+		Format:        "wacli.wrench-private-status",
+		Binding:       server.binding,
+		RecordedAt:    server.now().Format(time.RFC3339Nano),
+	}
+	if err := wrenchPrivateWriteStatus(a.StoreDir(), status); err != nil {
+		_ = listener.Close()
+		_ = os.Remove(path)
+		return nil, err
+	}
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			go server.handleConnection(ctx, conn)
+		}
+	}()
+	stop := func() {
+		_ = listener.Close()
+		<-done
+		_ = os.Remove(path)
+		_ = os.Remove(wrenchPrivateStatusPath(a.StoreDir()))
+	}
+	return stop, nil
+}
+
+func (s *wrenchPrivateServer) handleConnection(ctx context.Context, conn net.Conn) {
+	defer conn.Close()
+	_ = conn.SetDeadline(s.now().Add(wrenchPrivateMaxTimeout + 5*time.Second))
+	raw, err := wrenchPrivateReadBounded(conn, wrenchPrivateMaxPayload)
+	if err != nil {
+		return
+	}
+	var req wrenchPrivateWireRequest
+	if err := wrenchPrivateDecodeStrict(raw, &req); err != nil {
+		return
+	}
+	resp := s.handleRequest(ctx, req)
+	resp.Binding = s.binding
+	resp.Nonce = req.Nonce
+	resp.RecordedAt = s.now().Format(time.RFC3339Nano)
+	resp.MAC = wrenchPrivateSignResponse(s.key, resp)
+	_ = json.NewEncoder(conn).Encode(resp)
+}
+
+func (s *wrenchPrivateServer) handleRequest(ctx context.Context, req wrenchPrivateWireRequest) wrenchPrivateWireResponse {
+	if req.SchemaVersion != wrenchPrivateProtocolVersion {
+		return wrenchPrivateResult("failed", "protocol_version_mismatch", wrenchPrivateOutcome{})
+	}
+	if !wrenchPrivateEqualBinding(req.Binding, s.binding) {
+		return wrenchPrivateResult("failed", "daemon_binding_mismatch", wrenchPrivateOutcome{})
+	}
+	if len(req.Nonce) != 48 {
+		return wrenchPrivateResult("failed", "invalid_nonce", wrenchPrivateOutcome{})
+	}
+	if _, err := hex.DecodeString(req.Nonce); err != nil {
+		return wrenchPrivateResult("failed", "invalid_nonce", wrenchPrivateOutcome{})
+	}
+	issuedAt, err := time.Parse(time.RFC3339Nano, req.IssuedAt)
+	if err != nil || s.now().Sub(issuedAt) > wrenchPrivateMaxClockSkew || issuedAt.Sub(s.now()) > wrenchPrivateMaxClockSkew {
+		return wrenchPrivateResult("failed", "request_clock_window", wrenchPrivateOutcome{})
+	}
+	if !wrenchPrivateVerifyMAC(req.MAC, wrenchPrivateSignRequest(s.key, req)) {
+		return wrenchPrivateResult("failed", "request_authentication_failed", wrenchPrivateOutcome{})
+	}
+	if !s.replay.accept(req.Nonce, s.now()) {
+		return wrenchPrivateResult("failed", "replay_or_nonce_capacity", wrenchPrivateOutcome{})
+	}
+	currentEpoch, connected := s.engine.backend.ConnectionEpoch()
+	if !connected || currentEpoch != s.binding.ConnectionEpoch {
+		return wrenchPrivateResult("failed", "connection_epoch_drift", wrenchPrivateOutcome{})
+	}
+	switch req.Kind {
+	case "send":
+		return s.engine.send(ctx, req)
+	case "status_barrier":
+		if req.Send != nil {
+			return wrenchPrivateResult("failed", "invalid_request", wrenchPrivateOutcome{})
+		}
+		return s.engine.status(ctx)
+	default:
+		return wrenchPrivateResult("failed", "unsupported_request_kind", wrenchPrivateOutcome{})
+	}
+}
+
+func newWrenchPrivateCmd(flags *rootFlags) *cobra.Command {
+	cmd := &cobra.Command{
+		Use:   "wrench-private",
+		Short: "Use the pinned private Wrench mutation transport",
+	}
+	cmd.AddCommand(newWrenchPrivateSendCmd(flags))
+	cmd.AddCommand(newWrenchPrivateStatusCmd(flags))
+	return cmd
+}
+
+func newWrenchPrivateSendCmd(flags *rootFlags) *cobra.Command {
+	input := "-"
+	cmd := &cobra.Command{
+		Use:   "send",
+		Short: "Submit one private no-retry text payload from stdin or a 0600 file",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if err := flags.requireWritable(); err != nil {
+				return err
+			}
+			var raw []byte
+			var err error
+			if input == "-" {
+				raw, err = wrenchPrivateReadBounded(cmd.InOrStdin(), wrenchPrivateMaxPayload)
+			} else {
+				raw, err = wrenchPrivateReadFile(input, wrenchPrivateMaxPayload)
+			}
+			if err != nil {
+				return err
+			}
+			var payload wrenchPrivateSendPayload
+			if err := wrenchPrivateDecodeStrict(raw, &payload); err != nil {
+				return err
+			}
+			timeout, err := validateWrenchPrivateSend(&payload)
+			if err != nil {
+				return err
+			}
+			storeDir, err := resolveStoreDir(flags)
+			if err != nil {
+				return err
+			}
+			resp, err := wrenchPrivateCall(storeDir, "send", &payload, timeout)
+			if err != nil {
+				return err
+			}
+			if err := out.WriteJSON(cmd.OutOrStdout(), resp); err != nil {
+				return err
+			}
+			if !resp.OK {
+				return fmt.Errorf("wrench private send: %s (%s)", resp.State, resp.Reason)
+			}
+			return nil
+		},
+	}
+	cmd.Flags().StringVar(&input, "input", "-", "private JSON payload source: - for stdin or an owner-only 0600 file")
+	return cmd
+}
+
+func newWrenchPrivateStatusCmd(flags *rootFlags) *cobra.Command {
+	return &cobra.Command{
+		Use:   "status",
+		Short: "Authenticate, prove connection drain, and reconcile the mutation lane",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			storeDir, err := resolveStoreDir(flags)
+			if err != nil {
+				return err
+			}
+			resp, err := wrenchPrivateCall(storeDir, "status_barrier", nil, wrenchPrivateBarrierTimeout)
+			if err != nil {
+				return err
+			}
+			if err := out.WriteJSON(cmd.OutOrStdout(), resp); err != nil {
+				return err
+			}
+			if !resp.OK {
+				return fmt.Errorf("wrench private status: %s (%s)", resp.State, resp.Reason)
+			}
+			return nil
+		},
+	}
+}
diff --git a/cmd/wacli/wrench_private_engine.go b/cmd/wacli/wrench_private_engine.go
new file mode 100644
index 0000000000000000000000000000000000000000..62c24da61fe52fd91314912f3c5ac201d7acc308
--- /dev/null
+++ b/cmd/wacli/wrench_private_engine.go
@@ -0,0 +1,412 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/openclaw/wacli/internal/app"
+	"github.com/openclaw/wacli/internal/store"
+	"github.com/openclaw/wacli/internal/wa"
+	waProto "go.mau.fi/whatsmeow/binary/proto"
+	"go.mau.fi/whatsmeow/types"
+)
+
+const (
+	wrenchPrivateMinTimeout     = 100 * time.Millisecond
+	wrenchPrivateMaxTimeout     = 45 * time.Second
+	wrenchPrivateBarrierTimeout = 10 * time.Second
+)
+
+type wrenchPrivateCommittedProof struct {
+	Revision        string
+	BarrierSequence uint64
+}
+
+type wrenchPrivateBackend interface {
+	ConnectionEpoch() (uint64, bool)
+	GenerateMessageID() (string, error)
+	SendNoRetry(context.Context, string, string, string, time.Duration) error
+	PersistOutbound(context.Context, string, string, string, time.Time) error
+	Barrier(context.Context) (wa.WrenchBarrierProof, error)
+	ReadCommitted(string, string, string) (string, error)
+}
+
+type wrenchPrivateOutcome struct {
+	state              string
+	reason             string
+	routeSHA256        string
+	requestSHA256      string
+	messageID          string
+	messageIDSHA256    string
+	bodySHA256         string
+	to                 string
+	epoch              uint64
+	committedRevision  string
+	barrierSequence    uint64
+	timedOutToCaller   bool
+	transactionFailed  bool
+	possibleSubmission bool
+}
+
+type wrenchPrivateWorker struct {
+	done    chan struct{}
+	outcome wrenchPrivateOutcome
+}
+
+type wrenchPrivateMutationEngine struct {
+	mu             sync.Mutex
+	backend        wrenchPrivateBackend
+	epoch          uint64
+	barrierTimeout time.Duration
+	active         *wrenchPrivateWorker
+	poison         *wrenchPrivateOutcome
+}
+
+func newWrenchPrivateMutationEngine(backend wrenchPrivateBackend, epoch uint64) *wrenchPrivateMutationEngine {
+	return &wrenchPrivateMutationEngine{backend: backend, epoch: epoch, barrierTimeout: wrenchPrivateBarrierTimeout}
+}
+
+func validateWrenchPrivateSend(payload *wrenchPrivateSendPayload) (time.Duration, error) {
+	if payload == nil {
+		return 0, fmt.Errorf("send payload is required")
+	}
+	jid, err := types.ParseJID(strings.TrimSpace(payload.To))
+	if err != nil || jid.IsEmpty() || jid.Device != 0 {
+		return 0, fmt.Errorf("to must be one exact non-device JID")
+	}
+	if jid.String() != payload.To {
+		return 0, fmt.Errorf("to must use the canonical exact JID representation")
+	}
+	switch jid.Server {
+	case types.DefaultUserServer, types.HiddenUserServer, types.GroupServer:
+	default:
+		return 0, fmt.Errorf("unsupported exact JID server")
+	}
+	if payload.Message == "" || len([]byte(payload.Message)) > wrenchPrivateMaxMessage {
+		return 0, fmt.Errorf("message must be between 1 and %d bytes", wrenchPrivateMaxMessage)
+	}
+	if strings.TrimSpace(payload.Message) != payload.Message {
+		return 0, fmt.Errorf("leading or trailing whitespace is not qualified by this prototype")
+	}
+	if payload.ReplyTo != "" || payload.ReplyToSender != "" {
+		return 0, fmt.Errorf("replies are not qualified by this prototype")
+	}
+	if !payload.NoPreview {
+		return 0, fmt.Errorf("no_preview must be true")
+	}
+	if !payload.NoRetry {
+		return 0, fmt.Errorf("no_retry must be true")
+	}
+	timeout := time.Duration(payload.TimeoutMS) * time.Millisecond
+	if timeout < wrenchPrivateMinTimeout || timeout > wrenchPrivateMaxTimeout {
+		return 0, fmt.Errorf("timeout_ms must be between %d and %d", wrenchPrivateMinTimeout.Milliseconds(), wrenchPrivateMaxTimeout.Milliseconds())
+	}
+	return timeout, nil
+}
+
+func (e *wrenchPrivateMutationEngine) send(parent context.Context, request wrenchPrivateWireRequest) wrenchPrivateWireResponse {
+	timeout, err := validateWrenchPrivateSend(request.Send)
+	if err != nil {
+		return wrenchPrivateResult("failed", "invalid_request", wrenchPrivateOutcome{})
+	}
+	e.mu.Lock()
+	currentEpoch, connected := e.backend.ConnectionEpoch()
+	if !connected || currentEpoch != e.epoch {
+		e.mu.Unlock()
+		return wrenchPrivateResult("failed", "connection_epoch_drift", wrenchPrivateOutcome{})
+	}
+	if e.active != nil {
+		outcome := e.active.outcome
+		e.mu.Unlock()
+		return wrenchPrivateResult("still_in_flight", "mutation_worker_active", outcome)
+	}
+	if e.poison != nil {
+		outcome := *e.poison
+		e.mu.Unlock()
+		return wrenchPrivateResult("indeterminate", "route_lane_poisoned", outcome)
+	}
+	messageID, err := e.backend.GenerateMessageID()
+	if err != nil || strings.TrimSpace(messageID) == "" {
+		e.mu.Unlock()
+		return wrenchPrivateResult("failed", "message_id_unavailable", wrenchPrivateOutcome{})
+	}
+	outcome := wrenchPrivateOutcome{
+		state:           "started",
+		routeSHA256:     wrenchPrivateSubject(request.Send.To),
+		requestSHA256:   wrenchPrivateRequestHash(request),
+		messageID:       messageID,
+		messageIDSHA256: wrenchPrivateSubject(messageID),
+		bodySHA256:      wrenchPrivateHash([]byte(request.Send.Message)),
+		to:              strings.TrimSpace(request.Send.To),
+		epoch:           e.epoch,
+	}
+	worker := &wrenchPrivateWorker{done: make(chan struct{}), outcome: outcome}
+	initialOutcome := outcome
+	e.active = worker
+	e.mu.Unlock()
+
+	workerCtx, cancel := context.WithTimeout(context.WithoutCancel(parent), timeout)
+	go func(initial wrenchPrivateOutcome) {
+		defer cancel()
+		result := e.runWorker(workerCtx, initial, request.Send.Message, timeout)
+		e.mu.Lock()
+		result.timedOutToCaller = worker.outcome.timedOutToCaller
+		worker.outcome = result
+		if e.active == worker {
+			e.active = nil
+		}
+		if result.timedOutToCaller || result.state != "submitted" {
+			copy := result
+			e.poison = &copy
+		}
+		close(worker.done)
+		e.mu.Unlock()
+	}(initialOutcome)
+
+	timer := time.NewTimer(timeout)
+	defer timer.Stop()
+	select {
+	case <-worker.done:
+		e.mu.Lock()
+		result := worker.outcome
+		e.mu.Unlock()
+		return wrenchPrivateResult(result.state, result.reason, result)
+	case <-timer.C:
+		e.mu.Lock()
+		worker.outcome.timedOutToCaller = true
+		result := worker.outcome
+		e.mu.Unlock()
+		return wrenchPrivateResult("still_in_flight", "mutation_worker_active", result)
+	}
+}
+
+func (e *wrenchPrivateMutationEngine) runWorker(ctx context.Context, outcome wrenchPrivateOutcome, body string, timeout time.Duration) wrenchPrivateOutcome {
+	outcome.possibleSubmission = true
+	if err := e.backend.SendNoRetry(ctx, outcome.to, body, outcome.messageID, timeout); err != nil {
+		outcome.state = "indeterminate"
+		outcome.reason = "send_result_uncertain"
+		return outcome
+	}
+	if err := e.backend.PersistOutbound(context.WithoutCancel(ctx), outcome.to, outcome.messageID, body, time.Now().UTC()); err != nil {
+		outcome.state = "indeterminate"
+		outcome.reason = "transaction_failure"
+		outcome.transactionFailed = true
+		return outcome
+	}
+	barrierCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), e.barrierTimeout)
+	proof, err := e.backend.Barrier(barrierCtx)
+	cancel()
+	if err != nil {
+		outcome.state = "indeterminate"
+		outcome.reason = wrenchPrivateBarrierReason(err)
+		return outcome
+	}
+	if proof.ConnectionEpoch != outcome.epoch {
+		outcome.state = "indeterminate"
+		outcome.reason = "connection_epoch_drift"
+		return outcome
+	}
+	revision, err := e.backend.ReadCommitted(outcome.to, outcome.messageID, outcome.bodySHA256)
+	if err != nil {
+		outcome.state = "indeterminate"
+		outcome.reason = "committed_read_failure"
+		return outcome
+	}
+	if finalEpoch, connected := e.backend.ConnectionEpoch(); !connected || finalEpoch != outcome.epoch {
+		outcome.state = "indeterminate"
+		outcome.reason = "connection_epoch_drift"
+		return outcome
+	}
+	outcome.state = "submitted"
+	outcome.reason = ""
+	outcome.committedRevision = revision
+	outcome.barrierSequence = proof.ResponseSequence
+	return outcome
+}
+
+func (e *wrenchPrivateMutationEngine) status(parent context.Context) wrenchPrivateWireResponse {
+	e.mu.Lock()
+	currentEpoch, connected := e.backend.ConnectionEpoch()
+	if !connected || currentEpoch != e.epoch {
+		e.mu.Unlock()
+		return wrenchPrivateResult("failed", "connection_epoch_drift", wrenchPrivateOutcome{})
+	}
+	if e.active != nil {
+		outcome := e.active.outcome
+		e.mu.Unlock()
+		return wrenchPrivateResult("still_in_flight", "mutation_worker_active", outcome)
+	}
+	var prior *wrenchPrivateOutcome
+	if e.poison != nil {
+		copy := *e.poison
+		prior = &copy
+	}
+	e.mu.Unlock()
+
+	barrierCtx, cancel := context.WithTimeout(context.WithoutCancel(parent), e.barrierTimeout)
+	proof, err := e.backend.Barrier(barrierCtx)
+	cancel()
+	if err != nil {
+		outcome := wrenchPrivateOutcome{}
+		if prior != nil {
+			outcome = *prior
+		}
+		return wrenchPrivateResult("indeterminate", wrenchPrivateBarrierReason(err), outcome)
+	}
+	if proof.ConnectionEpoch != e.epoch {
+		return wrenchPrivateResult("failed", "connection_epoch_drift", wrenchPrivateOutcome{})
+	}
+	if finalEpoch, connected := e.backend.ConnectionEpoch(); !connected || finalEpoch != e.epoch {
+		return wrenchPrivateResult("failed", "connection_epoch_drift", wrenchPrivateOutcome{})
+	}
+	if prior == nil {
+		return wrenchPrivateResult("idle", "", wrenchPrivateOutcome{barrierSequence: proof.ResponseSequence})
+	}
+	if prior.transactionFailed {
+		return wrenchPrivateResult("indeterminate", "transaction_failure", *prior)
+	}
+	revision, readErr := e.backend.ReadCommitted(prior.to, prior.messageID, prior.bodySHA256)
+	if readErr != nil {
+		if errors.Is(readErr, sql.ErrNoRows) {
+			return wrenchPrivateResult("indeterminate", "submitted_state_not_observed", *prior)
+		}
+		return wrenchPrivateResult("indeterminate", "committed_read_failure", *prior)
+	}
+	if finalEpoch, connected := e.backend.ConnectionEpoch(); !connected || finalEpoch != e.epoch {
+		return wrenchPrivateResult("failed", "connection_epoch_drift", *prior)
+	}
+	prior.state = "submitted"
+	prior.reason = ""
+	prior.committedRevision = revision
+	prior.barrierSequence = proof.ResponseSequence
+	e.mu.Lock()
+	if e.poison != nil && e.poison.requestSHA256 == prior.requestSHA256 {
+		e.poison = nil
+	}
+	e.mu.Unlock()
+	return wrenchPrivateResult("submitted", "", *prior)
+}
+
+func wrenchPrivateBarrierReason(err error) string {
+	var barrierErr *wa.WrenchBarrierError
+	if errors.As(err, &barrierErr) && barrierErr.Category != "" {
+		return barrierErr.Category
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return "keepalive_timeout"
+	}
+	return "barrier_failure"
+}
+
+func wrenchPrivateResult(state, reason string, outcome wrenchPrivateOutcome) wrenchPrivateWireResponse {
+	return wrenchPrivateWireResponse{
+		SchemaVersion:     wrenchPrivateProtocolVersion,
+		OK:                state == "submitted" || state == "idle",
+		State:             state,
+		Reason:            reason,
+		RouteSHA256:       outcome.routeSHA256,
+		RequestSHA256:     outcome.requestSHA256,
+		MessageIDSHA256:   outcome.messageIDSHA256,
+		CommittedRevision: outcome.committedRevision,
+		BarrierSequence:   outcome.barrierSequence,
+		RecordedAt:        time.Now().UTC().Format(time.RFC3339Nano),
+	}
+}
+
+type wrenchPrivateAppBackend struct {
+	app       *app.App
+	transport wa.WrenchPrivateTransport
+}
+
+func newWrenchPrivateAppBackend(a *app.App) (*wrenchPrivateAppBackend, error) {
+	transport, ok := a.WA().(wa.WrenchPrivateTransport)
+	if !ok {
+		return nil, wa.ErrWrenchPrivateTransportUnavailable
+	}
+	if _, connected := transport.WrenchConnectionEpoch(); !connected {
+		return nil, wa.ErrWrenchPrivateTransportUnavailable
+	}
+	return &wrenchPrivateAppBackend{app: a, transport: transport}, nil
+}
+
+func (b *wrenchPrivateAppBackend) ConnectionEpoch() (uint64, bool) {
+	return b.transport.WrenchConnectionEpoch()
+}
+
+func (b *wrenchPrivateAppBackend) GenerateMessageID() (string, error) {
+	id, err := b.transport.WrenchGenerateMessageID()
+	return string(id), err
+}
+
+func (b *wrenchPrivateAppBackend) SendNoRetry(ctx context.Context, to, body, messageID string, timeout time.Duration) error {
+	jid, err := types.ParseJID(to)
+	if err != nil {
+		return err
+	}
+	msg := &waProto.Message{Conversation: &body}
+	return b.transport.WrenchSendProtoNoRetry(ctx, jid, msg, types.MessageID(messageID), timeout)
+}
+
+func (b *wrenchPrivateAppBackend) PersistOutbound(ctx context.Context, to, messageID, body string, now time.Time) error {
+	jid, err := types.ParseJID(to)
+	if err != nil {
+		return err
+	}
+	chatName := b.app.WA().ResolveChatName(ctx, jid, "")
+	if err := b.app.DB().UpsertChat(jid.String(), chatKindFromJID(jid), chatName, now); err != nil {
+		return err
+	}
+	return b.app.DB().UpsertMessage(store.UpsertMessageParams{
+		ChatJID:    jid.String(),
+		ChatName:   chatName,
+		MsgID:      messageID,
+		SenderName: "me",
+		Timestamp:  now,
+		FromMe:     true,
+		Text:       body,
+	})
+}
+
+func (b *wrenchPrivateAppBackend) Barrier(ctx context.Context) (wa.WrenchBarrierProof, error) {
+	return b.transport.WrenchReceiveBarrier(ctx)
+}
+
+func (b *wrenchPrivateAppBackend) ReadCommitted(to, messageID, bodySHA256 string) (string, error) {
+	message, err := b.app.DB().GetMessage(to, messageID)
+	if err != nil {
+		return "", err
+	}
+	if !message.FromMe || wrenchPrivateHash([]byte(message.Text)) != bodySHA256 {
+		return "", fmt.Errorf("committed message does not match exact outbound payload")
+	}
+	canonical := struct {
+		ChatJID         string `json:"chat_jid"`
+		MessageID       string `json:"message_id"`
+		Timestamp       string `json:"timestamp"`
+		FromMe          bool   `json:"from_me"`
+		BodySHA256      string `json:"body_sha256"`
+		QuotedMessageID string `json:"quoted_message_id"`
+		Revoked         bool   `json:"revoked"`
+		DeletedForMe    bool   `json:"deleted_for_me"`
+	}{
+		ChatJID:         message.ChatJID,
+		MessageID:       message.MsgID,
+		Timestamp:       message.Timestamp.UTC().Format(time.RFC3339Nano),
+		FromMe:          message.FromMe,
+		BodySHA256:      bodySHA256,
+		QuotedMessageID: message.QuotedMsgID,
+		Revoked:         message.Revoked,
+		DeletedForMe:    message.DeletedForMe,
+	}
+	raw, err := json.Marshal(canonical)
+	if err != nil {
+		return "", err
+	}
+	return wrenchPrivateHash(raw), nil
+}
diff --git a/cmd/wacli/wrench_private_engine_test.go b/cmd/wacli/wrench_private_engine_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..82f97490e2590bdc8177cf94f79222e4fcfae416
--- /dev/null
+++ b/cmd/wacli/wrench_private_engine_test.go
@@ -0,0 +1,296 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/wa"
+)
+
+type fakeWrenchPrivateBackend struct {
+	mu sync.Mutex
+
+	epoch     uint64
+	connected bool
+	nextID    string
+
+	sendCalls int
+	sendErr   error
+	sendBlock <-chan struct{}
+	sendStart chan struct{}
+
+	persistErr  error
+	persisted   chan struct{}
+	rows        map[string]string
+	driftOnRead bool
+
+	barrierCalls int
+	barrierErr   error
+	barrierBlock bool
+	sequence     uint64
+}
+
+func newFakeWrenchPrivateBackend() *fakeWrenchPrivateBackend {
+	return &fakeWrenchPrivateBackend{
+		epoch:     7,
+		connected: true,
+		nextID:    "message-1",
+		rows:      make(map[string]string),
+		sequence:  42,
+	}
+}
+
+func (f *fakeWrenchPrivateBackend) ConnectionEpoch() (uint64, bool) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.epoch, f.connected
+}
+
+func (f *fakeWrenchPrivateBackend) GenerateMessageID() (string, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.nextID, nil
+}
+
+func (f *fakeWrenchPrivateBackend) SendNoRetry(ctx context.Context, _, _, _ string, _ time.Duration) error {
+	f.mu.Lock()
+	f.sendCalls++
+	block := f.sendBlock
+	started := f.sendStart
+	err := f.sendErr
+	f.mu.Unlock()
+	if started != nil {
+		select {
+		case started <- struct{}{}:
+		default:
+		}
+	}
+	if block != nil {
+		<-block // Deliberately ignore ctx to model a late provider completion.
+	}
+	return err
+}
+
+func (f *fakeWrenchPrivateBackend) PersistOutbound(_ context.Context, to, id, body string, _ time.Time) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.persistErr != nil {
+		return f.persistErr
+	}
+	f.rows[to+"\x00"+id] = wrenchPrivateHash([]byte(body))
+	if f.persisted != nil {
+		close(f.persisted)
+		f.persisted = nil
+	}
+	return nil
+}
+
+func (f *fakeWrenchPrivateBackend) Barrier(ctx context.Context) (wa.WrenchBarrierProof, error) {
+	f.mu.Lock()
+	f.barrierCalls++
+	block := f.barrierBlock
+	err := f.barrierErr
+	epoch := f.epoch
+	sequence := f.sequence
+	f.mu.Unlock()
+	if block {
+		<-ctx.Done()
+		return wa.WrenchBarrierProof{}, ctx.Err()
+	}
+	if err != nil {
+		return wa.WrenchBarrierProof{}, err
+	}
+	return wa.WrenchBarrierProof{ConnectionEpoch: epoch, ResponseSequence: sequence}, nil
+}
+
+func (f *fakeWrenchPrivateBackend) ReadCommitted(to, id, bodyHash string) (string, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	got, ok := f.rows[to+"\x00"+id]
+	if !ok {
+		return "", sql.ErrNoRows
+	}
+	if got != bodyHash {
+		return "", errors.New("body hash mismatch")
+	}
+	if f.driftOnRead {
+		f.epoch++
+	}
+	return wrenchPrivateHash([]byte(to + "\x00" + id + "\x00" + got)), nil
+}
+
+func privateSendRequest(timeout time.Duration) wrenchPrivateWireRequest {
+	return wrenchPrivateWireRequest{
+		SchemaVersion: wrenchPrivateProtocolVersion,
+		Kind:          "send",
+		Nonce:         "00112233445566778899aabbccddeeff0011223344556677",
+		IssuedAt:      time.Now().UTC().Format(time.RFC3339Nano),
+		Send: &wrenchPrivateSendPayload{
+			To:        "15551234567@s.whatsapp.net",
+			Message:   "private payload sentinel",
+			NoPreview: true,
+			NoRetry:   true,
+			TimeoutMS: timeout.Milliseconds(),
+		},
+	}
+}
+
+func TestWrenchPrivateEngineSubmittedRequiresBarrierAndCommittedRead(t *testing.T) {
+	backend := newFakeWrenchPrivateBackend()
+	engine := newWrenchPrivateMutationEngine(backend, backend.epoch)
+	resp := engine.send(context.Background(), privateSendRequest(time.Second))
+	if !resp.OK || resp.State != "submitted" || resp.CommittedRevision == "" || resp.BarrierSequence != 42 {
+		t.Fatalf("response = %+v", resp)
+	}
+	backend.mu.Lock()
+	defer backend.mu.Unlock()
+	if backend.sendCalls != 1 {
+		t.Fatalf("send calls = %d, want 1", backend.sendCalls)
+	}
+	if backend.barrierCalls != 1 {
+		t.Fatalf("barrier calls = %d, want 1", backend.barrierCalls)
+	}
+}
+
+func TestWrenchPrivateEngineTimeoutOwnsLateWorkerAndPoisonsLane(t *testing.T) {
+	backend := newFakeWrenchPrivateBackend()
+	block := make(chan struct{})
+	backend.sendBlock = block
+	backend.sendStart = make(chan struct{}, 1)
+	persisted := make(chan struct{})
+	backend.persisted = persisted
+	engine := newWrenchPrivateMutationEngine(backend, backend.epoch)
+
+	request := privateSendRequest(wrenchPrivateMinTimeout)
+	resp := engine.send(context.Background(), request)
+	if resp.State != "still_in_flight" || resp.Reason != "mutation_worker_active" {
+		t.Fatalf("timeout response = %+v", resp)
+	}
+	blocked := engine.send(context.Background(), request)
+	if blocked.State != "still_in_flight" || blocked.Reason != "mutation_worker_active" {
+		t.Fatalf("second send was not blocked: %+v", blocked)
+	}
+
+	close(block)
+	select {
+	case <-persisted:
+	case <-time.After(time.Second):
+		t.Fatal("late worker did not persist")
+	}
+	deadline := time.Now().Add(time.Second)
+	for {
+		status := engine.status(context.Background())
+		if status.State == "submitted" {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("late completion did not reconcile: %+v", status)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	backend.mu.Lock()
+	if backend.sendCalls != 1 {
+		t.Fatalf("late completion was retried: calls=%d", backend.sendCalls)
+	}
+	backend.mu.Unlock()
+}
+
+func TestWrenchPrivateEngineNeverRetriesUncertainSend(t *testing.T) {
+	backend := newFakeWrenchPrivateBackend()
+	backend.sendErr = errors.New("response lost after frame write")
+	engine := newWrenchPrivateMutationEngine(backend, backend.epoch)
+	resp := engine.send(context.Background(), privateSendRequest(time.Second))
+	if resp.State != "indeterminate" || resp.Reason != "send_result_uncertain" {
+		t.Fatalf("response = %+v", resp)
+	}
+	blocked := engine.send(context.Background(), privateSendRequest(time.Second))
+	if blocked.Reason != "route_lane_poisoned" {
+		t.Fatalf("lane = %+v", blocked)
+	}
+	backend.mu.Lock()
+	defer backend.mu.Unlock()
+	if backend.sendCalls != 1 {
+		t.Fatalf("send calls = %d, want 1", backend.sendCalls)
+	}
+}
+
+func TestWrenchPrivateEngineFailsOnTransactionAndBarrierStates(t *testing.T) {
+	t.Run("transaction", func(t *testing.T) {
+		backend := newFakeWrenchPrivateBackend()
+		backend.persistErr = errors.New("commit failed")
+		engine := newWrenchPrivateMutationEngine(backend, backend.epoch)
+		resp := engine.send(context.Background(), privateSendRequest(time.Second))
+		if resp.State != "indeterminate" || resp.Reason != "transaction_failure" {
+			t.Fatalf("response = %+v", resp)
+		}
+		status := engine.status(context.Background())
+		if status.Reason != "transaction_failure" {
+			t.Fatalf("status = %+v", status)
+		}
+	})
+
+	for _, category := range []string{"queue_overflow", "escaped_or_late_handler", "transaction_or_handler_failure", "connection_epoch_drift"} {
+		t.Run(category, func(t *testing.T) {
+			backend := newFakeWrenchPrivateBackend()
+			backend.barrierErr = &wa.WrenchBarrierError{Category: category}
+			engine := newWrenchPrivateMutationEngine(backend, backend.epoch)
+			resp := engine.send(context.Background(), privateSendRequest(time.Second))
+			if resp.State != "indeterminate" || resp.Reason != category {
+				t.Fatalf("response = %+v", resp)
+			}
+		})
+	}
+}
+
+func TestWrenchPrivateEngineFailsOnBlackholeAndEpochDrift(t *testing.T) {
+	backend := newFakeWrenchPrivateBackend()
+	backend.barrierBlock = true
+	engine := newWrenchPrivateMutationEngine(backend, backend.epoch)
+	engine.barrierTimeout = 20 * time.Millisecond
+	resp := engine.send(context.Background(), privateSendRequest(time.Second))
+	if resp.State != "indeterminate" || resp.Reason != "keepalive_timeout" {
+		t.Fatalf("blackhole response = %+v", resp)
+	}
+
+	backend2 := newFakeWrenchPrivateBackend()
+	engine2 := newWrenchPrivateMutationEngine(backend2, backend2.epoch)
+	backend2.epoch++
+	drift := engine2.send(context.Background(), privateSendRequest(time.Second))
+	if drift.State != "failed" || drift.Reason != "connection_epoch_drift" {
+		t.Fatalf("epoch response = %+v", drift)
+	}
+
+	backend3 := newFakeWrenchPrivateBackend()
+	backend3.driftOnRead = true
+	engine3 := newWrenchPrivateMutationEngine(backend3, backend3.epoch)
+	finalDrift := engine3.send(context.Background(), privateSendRequest(time.Second))
+	if finalDrift.State != "indeterminate" || finalDrift.Reason != "connection_epoch_drift" {
+		t.Fatalf("final-read epoch response = %+v", finalDrift)
+	}
+}
+
+func TestValidateWrenchPrivateSendRequiresExactPrivateContract(t *testing.T) {
+	valid := privateSendRequest(time.Second).Send
+	if _, err := validateWrenchPrivateSend(valid); err != nil {
+		t.Fatalf("valid: %v", err)
+	}
+	tests := []func(*wrenchPrivateSendPayload){
+		func(p *wrenchPrivateSendPayload) { p.To = "Alice" },
+		func(p *wrenchPrivateSendPayload) { p.Message = " private" },
+		func(p *wrenchPrivateSendPayload) { p.NoPreview = false },
+		func(p *wrenchPrivateSendPayload) { p.NoRetry = false },
+		func(p *wrenchPrivateSendPayload) { p.ReplyTo = "not-qualified" },
+		func(p *wrenchPrivateSendPayload) { p.TimeoutMS = 1 },
+	}
+	for i, mutate := range tests {
+		copy := *valid
+		mutate(&copy)
+		if _, err := validateWrenchPrivateSend(&copy); err == nil {
+			t.Fatalf("case %d unexpectedly valid", i)
+		}
+	}
+}
diff --git a/cmd/wacli/wrench_private_protocol.go b/cmd/wacli/wrench_private_protocol.go
new file mode 100644
index 0000000000000000000000000000000000000000..410e08516568b431a0e665883916d94293c0aadd
--- /dev/null
+++ b/cmd/wacli/wrench_private_protocol.go
@@ -0,0 +1,352 @@
+package main
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/openclaw/wacli/internal/fsutil"
+)
+
+const (
+	wrenchPrivateProtocolVersion = 1
+	wrenchPrivateSocketName      = ".wrench-send.sock"
+	wrenchPrivateKeyName         = ".wrench-send.key"
+	wrenchPrivateStatusName      = ".wrench-send-status.json"
+	wrenchPrivateMaxPayload      = 32 * 1024
+	wrenchPrivateMaxMessage      = 16 * 1024
+	wrenchPrivateMaxClockSkew    = 30 * time.Second
+	wrenchPrivateReplayLimit     = 1024
+)
+
+const wrenchPrivateProtocolDescriptor = `{"format":"wacli.wrench-private-send","schemaVersion":1,"binding":["protocolHash","toolHash","storeSubject","authSubject","daemonPid","daemonStartedAt","connectionEpoch"],"requests":["send","status_barrier"],"transport":"owner-only-unix-socket+hmac-sha256","payload":"stdin-or-0600-file"}`
+
+type wrenchDaemonBinding struct {
+	ProtocolHash    string `json:"protocol_hash"`
+	ToolHash        string `json:"tool_hash"`
+	StoreSubject    string `json:"store_subject"`
+	AuthSubject     string `json:"auth_subject"`
+	DaemonPID       int    `json:"daemon_pid"`
+	DaemonStartedAt string `json:"daemon_started_at"`
+	ConnectionEpoch uint64 `json:"connection_epoch"`
+}
+
+type wrenchPrivateStatusFile struct {
+	SchemaVersion int                 `json:"schema_version"`
+	Format        string              `json:"format"`
+	Binding       wrenchDaemonBinding `json:"binding"`
+	RecordedAt    string              `json:"recorded_at"`
+}
+
+type wrenchPrivateSendPayload struct {
+	To            string `json:"to"`
+	Message       string `json:"message"`
+	ReplyTo       string `json:"reply_to,omitempty"`
+	ReplyToSender string `json:"reply_to_sender,omitempty"`
+	NoPreview     bool   `json:"no_preview"`
+	NoRetry       bool   `json:"no_retry"`
+	TimeoutMS     int64  `json:"timeout_ms"`
+}
+
+type wrenchPrivateWireRequest struct {
+	SchemaVersion int                       `json:"schema_version"`
+	Kind          string                    `json:"kind"`
+	Binding       wrenchDaemonBinding       `json:"binding"`
+	Nonce         string                    `json:"nonce"`
+	IssuedAt      string                    `json:"issued_at"`
+	Send          *wrenchPrivateSendPayload `json:"send,omitempty"`
+	MAC           string                    `json:"mac"`
+}
+
+type wrenchPrivateWireResponse struct {
+	SchemaVersion     int                 `json:"schema_version"`
+	OK                bool                `json:"ok"`
+	State             string              `json:"state"`
+	Reason            string              `json:"reason,omitempty"`
+	Binding           wrenchDaemonBinding `json:"binding"`
+	Nonce             string              `json:"nonce"`
+	RouteSHA256       string              `json:"route_sha256,omitempty"`
+	RequestSHA256     string              `json:"request_sha256,omitempty"`
+	MessageIDSHA256   string              `json:"message_id_sha256,omitempty"`
+	CommittedRevision string              `json:"committed_revision,omitempty"`
+	BarrierSequence   uint64              `json:"barrier_sequence,omitempty"`
+	RecordedAt        string              `json:"recorded_at"`
+	MAC               string              `json:"mac"`
+}
+
+func wrenchPrivateProtocolHash() string {
+	return wrenchPrivateHash([]byte(wrenchPrivateProtocolDescriptor))
+}
+
+func wrenchPrivateHash(data []byte) string {
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+func wrenchPrivateSubject(value string) string {
+	return wrenchPrivateHash([]byte(strings.TrimSpace(value)))
+}
+
+func wrenchPrivateRequestHash(req wrenchPrivateWireRequest) string {
+	copy := req
+	copy.MAC = ""
+	raw, _ := json.Marshal(copy)
+	return wrenchPrivateHash(raw)
+}
+
+func wrenchPrivateSignRequest(key []byte, req wrenchPrivateWireRequest) string {
+	req.MAC = ""
+	raw, _ := json.Marshal(req)
+	mac := hmac.New(sha256.New, key)
+	_, _ = mac.Write(raw)
+	return hex.EncodeToString(mac.Sum(nil))
+}
+
+func wrenchPrivateSignResponse(key []byte, resp wrenchPrivateWireResponse) string {
+	resp.MAC = ""
+	raw, _ := json.Marshal(resp)
+	mac := hmac.New(sha256.New, key)
+	_, _ = mac.Write(raw)
+	return hex.EncodeToString(mac.Sum(nil))
+}
+
+func wrenchPrivateVerifyMAC(got, want string) bool {
+	gotBytes, err := hex.DecodeString(got)
+	if err != nil {
+		return false
+	}
+	wantBytes, err := hex.DecodeString(want)
+	if err != nil {
+		return false
+	}
+	return hmac.Equal(gotBytes, wantBytes)
+}
+
+func wrenchPrivateNonce() (string, error) {
+	raw := make([]byte, 24)
+	if _, err := rand.Read(raw); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(raw), nil
+}
+
+func wrenchPrivateSocketPath(storeDir string) string {
+	return filepath.Join(storeDir, wrenchPrivateSocketName)
+}
+
+func wrenchPrivateKeyPath(storeDir string) string {
+	return filepath.Join(storeDir, wrenchPrivateKeyName)
+}
+
+func wrenchPrivateStatusPath(storeDir string) string {
+	return filepath.Join(storeDir, wrenchPrivateStatusName)
+}
+
+func wrenchPrivateReadFile(path string, limit int64) ([]byte, error) {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return nil, err
+	}
+	if info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("private input must be a regular non-symlink file")
+	}
+	if info.Mode().Perm() != 0o600 {
+		return nil, fmt.Errorf("private input mode must be 0600")
+	}
+	if info.Size() > limit {
+		return nil, fmt.Errorf("private input exceeds %d bytes", limit)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	return wrenchPrivateReadBounded(f, limit)
+}
+
+func wrenchPrivateReadBounded(reader io.Reader, limit int64) ([]byte, error) {
+	raw, err := io.ReadAll(io.LimitReader(reader, limit+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(raw)) > limit {
+		return nil, fmt.Errorf("private input exceeds %d bytes", limit)
+	}
+	return raw, nil
+}
+
+func wrenchPrivateDecodeStrict(raw []byte, target any) error {
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		return fmt.Errorf("invalid private JSON payload")
+	}
+	if decoder.Decode(&struct{}{}) != io.EOF {
+		return fmt.Errorf("private JSON payload must contain one value")
+	}
+	return nil
+}
+
+func wrenchPrivateLoadOrCreateKey(storeDir string) ([]byte, error) {
+	path := wrenchPrivateKeyPath(storeDir)
+	raw, err := wrenchPrivateReadFile(path, 64)
+	if err == nil {
+		if len(raw) != 32 {
+			return nil, fmt.Errorf("wrench private key has invalid length")
+		}
+		return raw, nil
+	}
+	if !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	raw = make([]byte, 32)
+	if _, err := rand.Read(raw); err != nil {
+		return nil, err
+	}
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := f.Write(raw); err != nil {
+		_ = f.Close()
+		return nil, err
+	}
+	if err := f.Close(); err != nil {
+		return nil, err
+	}
+	return raw, nil
+}
+
+func wrenchPrivateWriteStatus(storeDir string, status wrenchPrivateStatusFile) error {
+	raw, err := json.Marshal(status)
+	if err != nil {
+		return err
+	}
+	return fsutil.WritePrivateFileAtomic(wrenchPrivateStatusPath(storeDir), append(raw, '\n'))
+}
+
+func wrenchPrivateExecutableHash() (string, error) {
+	path, err := os.Executable()
+	if err != nil {
+		return "", err
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return "", err
+	}
+	defer f.Close()
+	hash := sha256.New()
+	if _, err := io.Copy(hash, f); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(hash.Sum(nil)), nil
+}
+
+type wrenchPrivateReplayCache struct {
+	mu    sync.Mutex
+	seen  map[string]time.Time
+	limit int
+}
+
+func newWrenchPrivateReplayCache(limit int) *wrenchPrivateReplayCache {
+	return &wrenchPrivateReplayCache{seen: make(map[string]time.Time), limit: limit}
+}
+
+func (c *wrenchPrivateReplayCache) accept(nonce string, now time.Time) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for key, seenAt := range c.seen {
+		if now.Sub(seenAt) > 2*wrenchPrivateMaxClockSkew {
+			delete(c.seen, key)
+		}
+	}
+	if _, exists := c.seen[nonce]; exists || len(c.seen) >= c.limit {
+		return false
+	}
+	c.seen[nonce] = now
+	return true
+}
+
+func wrenchPrivateEqualBinding(a, b wrenchDaemonBinding) bool {
+	return a == b
+}
+
+func wrenchPrivateCall(storeDir string, kind string, send *wrenchPrivateSendPayload, timeout time.Duration) (wrenchPrivateWireResponse, error) {
+	statusRaw, err := wrenchPrivateReadFile(wrenchPrivateStatusPath(storeDir), wrenchPrivateMaxPayload)
+	if err != nil {
+		return wrenchPrivateWireResponse{}, fmt.Errorf("read private transport status: %w", err)
+	}
+	var status wrenchPrivateStatusFile
+	if err := wrenchPrivateDecodeStrict(statusRaw, &status); err != nil {
+		return wrenchPrivateWireResponse{}, err
+	}
+	if status.SchemaVersion != wrenchPrivateProtocolVersion || status.Format != "wacli.wrench-private-status" {
+		return wrenchPrivateWireResponse{}, fmt.Errorf("unsupported private transport status")
+	}
+	toolHash, err := wrenchPrivateExecutableHash()
+	if err != nil {
+		return wrenchPrivateWireResponse{}, err
+	}
+	if status.Binding.ToolHash != toolHash || status.Binding.ProtocolHash != wrenchPrivateProtocolHash() {
+		return wrenchPrivateWireResponse{}, fmt.Errorf("private transport tool or protocol hash mismatch")
+	}
+	key, err := wrenchPrivateReadFile(wrenchPrivateKeyPath(storeDir), 64)
+	if err != nil || len(key) != 32 {
+		return wrenchPrivateWireResponse{}, fmt.Errorf("read private transport key")
+	}
+	nonce, err := wrenchPrivateNonce()
+	if err != nil {
+		return wrenchPrivateWireResponse{}, err
+	}
+	req := wrenchPrivateWireRequest{
+		SchemaVersion: wrenchPrivateProtocolVersion,
+		Kind:          kind,
+		Binding:       status.Binding,
+		Nonce:         nonce,
+		IssuedAt:      time.Now().UTC().Format(time.RFC3339Nano),
+		Send:          send,
+	}
+	req.MAC = wrenchPrivateSignRequest(key, req)
+
+	ctxDeadline := time.Now().Add(timeout + 2*time.Second)
+	var dialer net.Dialer
+	conn, err := dialer.Dial("unix", wrenchPrivateSocketPath(storeDir))
+	if err != nil {
+		return wrenchPrivateWireResponse{}, err
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(ctxDeadline)
+	if err := json.NewEncoder(conn).Encode(req); err != nil {
+		return wrenchPrivateWireResponse{}, err
+	}
+	if unixConn, ok := conn.(*net.UnixConn); ok {
+		if err := unixConn.CloseWrite(); err != nil {
+			return wrenchPrivateWireResponse{}, err
+		}
+	}
+	var resp wrenchPrivateWireResponse
+	decoder := json.NewDecoder(io.LimitReader(conn, wrenchPrivateMaxPayload+1))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&resp); err != nil {
+		return wrenchPrivateWireResponse{}, err
+	}
+	if resp.Nonce != nonce || !wrenchPrivateEqualBinding(resp.Binding, status.Binding) {
+		return wrenchPrivateWireResponse{}, fmt.Errorf("private transport response binding mismatch")
+	}
+	if !wrenchPrivateVerifyMAC(resp.MAC, wrenchPrivateSignResponse(key, resp)) {
+		return wrenchPrivateWireResponse{}, fmt.Errorf("private transport response authentication failed")
+	}
+	return resp, nil
+}
