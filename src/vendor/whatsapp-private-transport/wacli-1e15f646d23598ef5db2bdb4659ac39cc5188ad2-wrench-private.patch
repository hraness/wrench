++package whatsmeow
++
++import (
++	"context"
++	"errors"
++	"testing"
++	"time"
++
++	"go.mau.fi/whatsmeow/types"
++)
++
++func TestWrenchReceiveBarrierUsesExactNoRetryKeepalive(t *testing.T) {
++	timeout := 2 * time.Second
++	query := wrenchKeepaliveQuery("barrier-id", timeout)
++	if query.Namespace != "w:p" || query.Type != iqGet || query.To != types.ServerJID {
++		t.Fatalf("keepalive query = %+v", query)
++	}
++	if query.ID != "barrier-id" || query.Timeout != timeout || !query.NoRetry {
++		t.Fatalf("bounded no-retry query = %+v", query)
++	}
++}
++
++func TestWrenchNoRetryDisablesEveryApplicationLevelRetryPath(t *testing.T) {
++	if shouldCacheMessageForRetry(SendRequestExtra{NoRetry: true}) {
++		t.Fatal("no-retry message retained for retry receipts")
++	}
++	if shouldCacheMessageForRetry(SendRequestExtra{Peer: true}) {
++		t.Fatal("peer message retained for unsupported retry path")
++	}
++	if !shouldCacheMessageForRetry(SendRequestExtra{}) {
++		t.Fatal("ordinary message retry behavior changed")
++	}
++}
++
++func TestWrenchReceiveBarrierWaitsForEarlierHandlers(t *testing.T) {
++	state := newWrenchReceiveBarrierState()
++	epoch := state.beginConnection()
++	_, first := state.observeFrame()
++	state.registerHandler(epoch, first)
++	_, response := state.observeFrame()
++
++	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
++	defer cancel()
++	done := make(chan error, 1)
++	go func() { done <- state.wait(ctx, epoch, response) }()
++
++	select {
++	case err := <-done:
++		t.Fatalf("barrier returned before handler completion: %v", err)
++	case <-time.After(20 * time.Millisecond):
++	}
++	state.finishHandler(epoch, first)
++	if err := <-done; err != nil {
++		t.Fatalf("barrier wait: %v", err)
++	}
++}
++
++func TestWrenchReceiveBarrierFailsClosed(t *testing.T) {
++	tests := []struct {
++		name string
++		mark func(*wrenchReceiveBarrierState, uint64, uint64)
++		want error
++	}{
++		{"queue overflow", (*wrenchReceiveBarrierState).markQueueOverflow, ErrWrenchBarrierQueueOverflow},
++		{"escaped handler", (*wrenchReceiveBarrierState).markHandlerEscaped, ErrWrenchBarrierHandlerEscaped},
++	}
++	for _, tc := range tests {
++		t.Run(tc.name, func(t *testing.T) {
++			state := newWrenchReceiveBarrierState()
++			epoch := state.beginConnection()
++			_, sequence := state.observeFrame()
++			tc.mark(state, epoch, sequence)
++			err := state.wait(context.Background(), epoch, sequence)
++			if !errors.Is(err, tc.want) {
++				t.Fatalf("error = %v, want %v", err, tc.want)
++			}
++		})
++	}
++}
++
++func TestWrenchReceiveBarrierFailsOnHandlerAndTransactionFailure(t *testing.T) {
++	state := newWrenchReceiveBarrierState()
++	epoch := state.beginConnection()
++	_, sequence := state.observeFrame()
++	state.registerHandler(epoch, sequence)
++	if !state.startHandler(epoch, sequence) {
++		t.Fatal("handler did not start")
++	}
++	state.markActiveHandlerFailed()
++	state.finishHandler(epoch, sequence)
++	if err := state.wait(context.Background(), epoch, sequence); !errors.Is(err, ErrWrenchBarrierHandlerFailed) {
++		t.Fatalf("error = %v, want handler failure", err)
++	}
++}
++
++func TestWrenchReceiveBarrierRejectsReconnectAndLateCompletion(t *testing.T) {
++	state := newWrenchReceiveBarrierState()
++	oldEpoch := state.beginConnection()
++	_, sequence := state.observeFrame()
++	state.registerHandler(oldEpoch, sequence)
++	if !state.startHandler(oldEpoch, sequence) {
++		t.Fatal("handler did not start")
++	}
++	state.endConnection()
++	newEpoch := state.beginConnection()
++	if newEpoch == oldEpoch {
++		t.Fatal("connection epoch did not advance")
++	}
++	state.finishHandler(oldEpoch, sequence)
++	if err := state.wait(context.Background(), oldEpoch, sequence); !errors.Is(err, ErrWrenchBarrierEpochDrift) {
++		t.Fatalf("old epoch error = %v, want epoch drift", err)
++	}
++	if err := state.wait(context.Background(), newEpoch, sequence); !errors.Is(err, ErrWrenchBarrierHandlerEscaped) {
++		t.Fatalf("new epoch late-handler error = %v, want escaped handler", err)
++	}
++}
++
++func TestWrenchReceiveBarrierRequiresBoundedContext(t *testing.T) {
++	client := &Client{wrenchReceiveBarrier: newWrenchReceiveBarrierState()}
++	client.wrenchReceiveBarrier.beginConnection()
++	if _, err := client.WrenchReceiveBarrier(context.Background()); err == nil {
++		t.Fatal("expected missing-deadline error")
++	}
++}
