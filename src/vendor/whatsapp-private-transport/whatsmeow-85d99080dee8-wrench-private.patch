+func TestWrenchReceiveBarrierRejectsReconnectAndLateCompletion(t *testing.T) {
+	state := newWrenchReceiveBarrierState()
+	oldEpoch := state.beginConnection()
+	_, sequence := state.observeFrame()
+	state.registerHandler(oldEpoch, sequence)
+	if !state.startHandler(oldEpoch, sequence) {
+		t.Fatal("handler did not start")
+	}
+	state.endConnection()
+	newEpoch := state.beginConnection()
+	if newEpoch == oldEpoch {
+		t.Fatal("connection epoch did not advance")
+	}
+	state.finishHandler(oldEpoch, sequence)
+	if err := state.wait(context.Background(), oldEpoch, sequence); !errors.Is(err, ErrWrenchBarrierEpochDrift) {
+		t.Fatalf("old epoch error = %v, want epoch drift", err)
+	}
+	if err := state.wait(context.Background(), newEpoch, sequence); !errors.Is(err, ErrWrenchBarrierHandlerEscaped) {
+		t.Fatalf("new epoch late-handler error = %v, want escaped handler", err)
+	}
+}
