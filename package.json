  "scripts": {
    "website:build": "bun run website/build.ts",
    "website:test": "bun test ./website ./edge",
    "website:typecheck": "tsc --noEmit --project website/tsconfig.json && tsc --noEmit --project edge/tsconfig.json",
    "website:check": "bun run website:typecheck && bun run website:test && bun run website:build",
    "build": "bun -e 'await (await import(\"node:fs/promises\")).rm(\"./dist\", { recursive: true, force: true })' && bun build ./src/index.ts ./src/client.ts ./src/beeper-client.ts ./src/omni-client.ts --outdir ./dist --root ./src --target bun --format esm --splitting --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test --no-orphans --timeout 180000 --max-concurrency \"${GOMAXPROCS:-4}\" ./src --path-ignore-patterns='**/src/omni-runtime.test.ts' && bun test --no-orphans --timeout 180000 --max-concurrency 1 ./src/omni-runtime.test.ts",
    "accept:media:adaptive": "bun run scripts/media/adaptive-vod-acceptance.ts",
    "accept:media:authenticated": "bun run scripts/media/authenticated-capture-acceptance.ts",
    "test:standalone": "bun run scripts/standalone-smoke.ts",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "test:npm-release": "bun test ./scripts/npm-stage-workflow.test.ts",
    "check": "bun run typecheck && bun run website:check && bun run test:npm-release && bun run build && bun run test:package && bun run test && bun run test:standalone",
    "kb:refresh": "bunx --bun github:hraness/kb#v0.15.2 refresh --root kb",
    "kb:check:lane": "bunx --bun github:hraness/kb#v0.15.2 check --root kb --no-catalog",
    "kb:check": "bunx --bun github:hraness/kb#v0.15.2 check --root kb && bunx --bun github:hraness/kb#v0.15.2 agents check --root kb --repo .",
    "kb:catalog": "bunx --bun github:hraness/kb#v0.15.2 catalog --root kb",
    "prepack": "bun run check"
  },
